generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERVISOR
  STUDENT_COACH
}

enum TestType {
  ANCLAS_CARRERA
  TABLERO_IDEAS
  PLAN_VITAL
  PIRAMIDE_PROPOSITO
  MODELO_NEGOCIO
}

enum SupervisionStatus {
  PENDING
  REVIEWED
}

enum ModuleItemKind {
  TAREA
  BIBLIOGRAFIA
  PRESENTACION
  LINK
  RECURSO
}

enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String? // null until the invited coach registers (invite-only)
  role      Role     @default(STUDENT_COACH)
  createdAt DateTime @default(now())

  // Invite-only registration (pending until the coach sets a password)
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  // Coach profile (filled by the coach at registration)
  phone        String?
  especialidad String?
  bio          String?

  clients             Client[]
  coacheeProfile      Client?              @relation("CoachAsCoachee")
  enrollments         Enrollment[]
  moduleProgress      ModuleProgress[]
  moduleItemProgress  ModuleItemProgress[]
  supervisionRequests SupervisionRequest[] @relation("StudentRequests")
  supervisionReviews  SupervisionRequest[] @relation("SupervisorReviews")
  sessionRecords      SessionRecord[]
  resetRequestsMade   TestResetRequest[]   @relation("ResetRequestedBy")
  resetReviews        TestResetRequest[]   @relation("ResetReviewedBy")
  signupReviews       SignupRequest[]      @relation("SignupReviewedBy")
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Zoom link for the whole camada (shown to enrolled coaches).
  zoomUrl String?

  // The supervisor opens these per cohort: first they take the course, later
  // they get to load coachees and run tests on them.
  clientsEnabled Boolean @default(false)
  testsEnabled   Boolean @default(false)

  enrollments    Enrollment[]
  moduleReleases ModuleRelease[]
  signupRequests SignupRequest[]
  signupLinks    SignupLink[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  cohortId   String
  user       User     @relation(fields: [userId], references: [id])
  cohort     Cohort   @relation(fields: [cohortId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([userId, cohortId])
}

/// A class of the CIC. The content is shared by every cohort; what varies per
/// cohort is WHEN it becomes visible — see ModuleRelease.
model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  orderIndex  Int
  /// false = draft, invisible to everyone regardless of releases.
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  items    ModuleItem[]
  progress ModuleProgress[]
  releases ModuleRelease[]
}

/// A card inside a module (mirrors a Trello card): "TAREA 1", "BIBLIOGRAFIA",
/// "PPT de la clase". Carries the consigna as free text plus a list of links.
/// Per-item completion. The item is the unit the coach ticks off; a module counts
/// as completed when it has items and all of them are done — that derived state
/// is mirrored into ModuleProgress so the supervisor stats keep working.
model ModuleItemProgress {
  id          String     @id @default(cuid())
  userId      String
  itemId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        ModuleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedAt DateTime   @default(now())

  @@unique([userId, itemId])
}

model ModuleItem {
  id          String         @id @default(cuid())
  moduleId    String
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  /// The consigna / long description. Plain text, newlines preserved.
  description String?
  kind        ModuleItemKind @default(RECURSO)
  orderIndex  Int            @default(0)
  createdAt   DateTime       @default(now())

  links    ModuleLink[]
  progress ModuleItemProgress[]
}

/// A link hanging off a card. Nothing is ever uploaded or stored by this app —
/// these point at Drive / Docs / Zoom / articles living elsewhere.
model ModuleLink {
  id         String     @id @default(cuid())
  itemId     String
  item       ModuleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title      String
  url        String
  orderIndex Int        @default(0)
  createdAt  DateTime   @default(now())

  /// Set when the file was uploaded through the app and lives in R2 — it is the
  /// object key, needed to delete the blob when the link goes away. Null means a
  /// plain external link (Drive, an article, Zoom) that we do not own.
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
}

/// Per-cohort visibility of a shared module. Absent row = never released.
model ModuleRelease {
  id       String @id @default(cuid())
  moduleId String
  cohortId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  released      Boolean   @default(false)
  /// Optional scheduled opening. When set and in the future, the module stays
  /// hidden even if `released` is true.
  availableFrom DateTime?

  updatedAt DateTime @updatedAt

  @@unique([moduleId, cohortId])
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  user        User     @relation(fields: [userId], references: [id])
  module      Module   @relation(fields: [moduleId], references: [id])
  completedAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model Client {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation(fields: [studentId], references: [id])
  name        String
  email       String
  // For a coach-as-coachee, points at the coach's own User (they take tests
  // logged-in). null for normal coachees (no login, magic-link only).
  userId      String?          @unique
  user        User?            @relation("CoachAsCoachee", fields: [userId], references: [id])
  assignments TestAssignment[]
  sessions    SessionRecord[]
  createdAt   DateTime         @default(now())
}

model Test {
  id          String           @id @default(cuid())
  type        TestType         @unique
  title       String
  description String
  orderIndex  Int
  assignments TestAssignment[]
}

model TestAssignment {
  id          String    @id @default(cuid())
  testId      String
  test        Test      @relation(fields: [testId], references: [id])
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  assignedBy  String
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  // A1 magic-link fields
  accessToken          String?   @unique
  completeBy           DateTime?
  resultsViewableUntil DateTime?

  response      TestResponse?
  supervision   SupervisionRequest?
  resetRequests TestResetRequest[]

  @@unique([testId, clientId])
}

model TestResponse {
  id           String         @id @default(cuid())
  assignmentId String         @unique
  assignment   TestAssignment @relation(fields: [assignmentId], references: [id])
  responses    Json
  submittedAt  DateTime       @default(now())
}

model SupervisionRequest {
  id              String            @id @default(cuid())
  assignmentId    String            @unique
  assignment      TestAssignment    @relation(fields: [assignmentId], references: [id])
  studentId       String
  student         User              @relation("StudentRequests", fields: [studentId], references: [id])
  studentNotes    String?
  supervisorId    String?
  supervisor      User?             @relation("SupervisorReviews", fields: [supervisorId], references: [id])
  supervisorNotes String?
  coachFeedback   String?
  status          SupervisionStatus @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
}

// Coach asks to reset (wipe) a submitted test so it can be retaken. The reset only
// happens once the supervisor approves it.
model TestResetRequest {
  id            String         @id @default(cuid())
  assignmentId  String
  assignment    TestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("ResetRequestedBy", fields: [requestedById], references: [id])
  reason        String?
  status        ResetStatus    @default(PENDING)
  reviewedById  String?
  reviewedBy    User?          @relation("ResetReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
}

model SessionRecord {
  id         String @id @default(cuid())
  studentId  String
  student    User   @relation(fields: [studentId], references: [id])
  clientId   String
  client     Client @relation(fields: [clientId], references: [id])
  sessionNum Int

  coacheeName     String
  coacheeAge      String
  coacheeSex      String
  coacheeWorks    Boolean
  coacheePosition String?
  sessionDate     DateTime
  mainOutputs     String
  toolsAndResults String
  conclusions     String

  createdAt DateTime @default(now())
}

/// A coach applying through the public signup link. No User exists until the
/// supervisor approves: the password they choose is hashed here and copied over
/// on approval, so they can log in immediately without a second email round-trip.
model SignupRequest {
  id           String  @id @default(cuid())
  name         String
  email        String
  phone        String?
  especialidad String?
  /// Why they want to join — free text from the form.
  motivation   String?

  /// The CIC they are applying to. Kept nullable so a cohort can be deleted
  /// without destroying the historical request.
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  passwordHash String
  status       SignupStatus @default(PENDING)

  /// Which shared link this came through (null for older requests).
  signupLinkId String?
  signupLink   SignupLink? @relation(fields: [signupLinkId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("SignupReviewedBy", fields: [reviewedById], references: [id])
  /// Set when rejected, so the supervisor remembers why.
  reviewNote   String?

  @@index([status])
}

/// Single-row table (id is always "singleton") holding the durations the
/// supervisor can tune from the UI, so link lifetimes are not hardcoded.
model AppSettings {
  id String @id @default("singleton")

  /// Days a coachee has to COMPLETE a test from the magic link.
  testCompleteDays Int @default(14)
  /// Days the results stay readable after submitting.
  testResultsDays  Int @default(365)
  /// Default lifetime of a newly generated public signup link.
  signupLinkDays   Int @default(30)

  updatedAt DateTime @updatedAt
}

/// A shareable signup link. Gaby generates one (optionally bound to a CIC), it
/// expires, and it can be revoked early. Replaces a single static /inscripcion URL.
model SignupLink {
  id    String @id @default(cuid())
  token String @unique

  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  expiresAt DateTime
  /// Revoked by hand before expiry.
  disabled  Boolean  @default(false)

  createdAt DateTime @default(now())

  requests SignupRequest[]
}
