# Poligiros environment variables.
#
# Architecture: frontend on Cloudflare Pages, backend dockerized (your machine or
# the Hetzner server), exposed via a Cloudflare Tunnel. There are three .env files:
#
#   .env            ← ROOT: read by BOTH docker-compose.local.yml (your machine)
#                     and docker-compose.prod.yml (the server, at /opt/poligiros/.env).
#                     It is gitignored, so `git pull` never brings it — create it
#                     on the server by hand the first time.
#   backend/.env    ← host-side prisma commands (migrate / studio) outside docker
#   frontend/.env   ← only if you run the frontend locally with `vite dev`
#
# (The Cloudflare Pages frontend gets its VITE_API_URL from the Pages dashboard,
#  not from a file.)

# ═════════════════════════════════════════════════════════════════════════════
# ROOT  (.env)  — drives the dockerized stack
# ═════════════════════════════════════════════════════════════════════════════

# Postgres (the docker container)
POSTGRES_USER=poligiros
POSTGRES_PASSWORD=<una-contraseña-para-la-DB>
POSTGRES_DB=poligiros

# Backend
JWT_SECRET=generate-with-openssl-rand-base64-32      # openssl rand -base64 32
FRONTEND_URL=https://apppoligiros.flynnpedroa.engineer  # Cloudflare Pages origin — must match
                                                     # EXACTLY, it is the CORS allow-list

# Cloudflare Tunnel — token from Zero Trust ▸ Networks ▸ Tunnels ▸ (your tunnel)
# Its Public Hostname must point at HTTP → api:3001 (the compose service name).
CLOUDFLARE_TUNNEL_TOKEN=

# Supervisor login (Gaby). Used by `make prod-supervisor` / `make prod-bootstrap`,
# which upsert just this user — and by the destructive demo `db:seed`.
# Override per-run instead: make prod-supervisor EMAIL=... PASSWORD=...
SUPERVISOR_EMAIL=<email-de-la-supervisora>
SUPERVISOR_PASSWORD=<poné-una-contraseña-de-8-o-más>
SUPERVISOR_NAME=<nombre y apellido>

# Optional — features fail gracefully if blank
OPENAI_API_KEY=                                      # Anclas AI insight
RESEND_API_KEY=                                      # notification emails
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=poligiros
CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.r2.dev

# ═════════════════════════════════════════════════════════════════════════════
# backend/.env  — for host-side prisma commands against the dockerized DB
# (host sees Postgres on localhost:5432; the container sees it as `postgres`)
# ═════════════════════════════════════════════════════════════════════════════

# DATABASE_URL=postgresql://poligiros:<password>@localhost:5432/poligiros
# JWT_SECRET=...            # same value as ROOT
# SUPERVISOR_EMAIL=<email-de-la-supervisora>
# SUPERVISOR_PASSWORD=<la-misma-que-arriba>

# ═════════════════════════════════════════════════════════════════════════════
# frontend/.env  — ONLY for local `npm run dev` (the Pages build uses the dashboard)
# ═════════════════════════════════════════════════════════════════════════════

# VITE_API_URL=http://localhost:3001
